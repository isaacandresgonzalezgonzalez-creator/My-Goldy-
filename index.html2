<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>My Goldy - Multijugador</title>
    <!-- Firebase App (Base de Firebase) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <!-- Firebase Database (Base de datos en tiempo real) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
    <style>
        body { margin: 0; background: #2c3e50; color: white; text-align: center; font-family: sans-serif; touch-action: manipulation; }
        #gameCanvas { background: #9ccc65; display: block; margin: 10px auto; border: 4px solid #5D4037; border-radius: 12px; max-width: 90vw; }
        .header-stats { background: #34495e; padding: 10px; font-size: 16px; position: relative; }
        .stats { display: flex; justify-content: space-around; padding: 5px; flex-wrap: wrap; gap: 5px; }
        .controls { padding: 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; max-width: 400px; margin: 0 auto; }
        button { padding: 15px; font-size: 16px; border-radius: 10px; border: none; background: #e67e22; color: white; cursor: pointer; }
        button:active { transform: scale(0.95); background: #d35400; }
        .menu-btn { background: #8e44ad; grid-column: span 2; }
        #logrosBtn { background: #d35400; grid-column: span 2; }
        #maxBtn { background: #27ae60; grid-column: span 2; }
        #fondosBtn { background: #2980b9; grid-column: span 2; }
        #resetBtn { background: #c0392b; grid-column: span 2; }
        #bathBtn { background: #16a085; }
        #infoBtn { background: #2980b9; grid-column: span 2; }
        #chatBtn { background: #16a085; grid-column: span 2; }
        
        #toqueBtn { 
            background: #e74c3c; 
            grid-column: span 2; 
            padding: 8px 12px; 
            font-size: 13px; 
            max-width: 160px; 
            margin: 0 auto; 
            border-radius: 6px;
            border: 2px solid #c0392b;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        #retosBtnHeader {
            background: #2980b9;
            border: 2px solid #f39c12;
            padding: 6px 10px;
            font-size: 14px;
            border-radius: 20px;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        #retosBtnHeader:active { transform: scale(0.95); }
        
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); justify-content: center; align-items: center; z-index: 10; }
        .modal-content { background: #34495e; padding: 15px; border-radius: 12px; width: 85%; max-width: 330px; text-align: center; border: 3px solid #e67e22; max-height: 90vh; overflow-y: auto; box-sizing: border-box; }
        .modal-content h3 { margin-top: 0; color: #f39c12; font-size: 18px; }
        .item-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 15px 0; max-height: 250px; overflow-y: auto; }
        .item-btn { background: #2980b9; padding: 10px; font-size: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
        .close-btn { background: #c0392b; width: 100%; margin-top: 8px; padding: 10px; font-size: 15px; font-weight: bold; border-radius: 8px; border: none; color: white; cursor: pointer; }
        
        .vestidor-tabs { display: flex; justify-content: space-around; margin-bottom: 10px; }
        .tab-btn { background: #34495e; border: 2px solid #e67e22; padding: 8px 12px; font-size: 13px; border-radius: 6px; color: white; cursor: pointer; }
        .tab-btn.active { background: #e67e22; }
        .vestidor-section { display: none; }
        .vestidor-section.active { display: block; }

        .info-box { text-align: left; background: #2c3e50; padding: 10px; border-radius: 8px; margin: 8px 0; font-size: 13px; line-height: 1.4; }
        .info-box p { margin: 4px 0; }
        .name-input-container { margin: 8px 0; }
        .name-input-container input { padding: 6px; width: 70%; border-radius: 6px; border: none; font-size: 13px; text-align: center; }

        .logro-card { background: #2c3e50; padding: 8px; border-radius: 8px; border: 2px solid #7f8c8d; display: flex; align-items: center; gap: 8px; font-size: 12px; margin-bottom: 6px; text-align: left; }
        .logro-card.desbloqueado { border-color: #27ae60; background: #27ae6020; }
        .logro-icono { font-size: 20px; min-width: 25px; text-align: center; }
        .logro-info h4 { margin: 0 0 2px 0; color: #f39c12; font-size: 13px; }
        .logro-info p { margin: 0; color: #bdc3c7; font-size: 10px; }

        #notificacionLogro { position: fixed; top: -70px; left: 50%; transform: translateX(-50%); background: #27ae60; color: white; padding: 10px 15px; border-radius: 8px; font-weight: bold; font-size: 13px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); transition: top 0.4s ease; z-index: 1000; border: 2px solid #2ecc71; text-align: center; }
        #notificacionLogro.mostrar { top: 15px; }

        #goldyReaccion { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); background: #f39c12; color: #2c3e50; padding: 6px 12px; border-radius: 15px; font-weight: bold; font-size: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.3); display: none; z-index: 1000; border: 2px solid #d35400; text-align: center; }
        #avisoDinero { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: #c0392b; color: white; padding: 8px 16px; border-radius: 8px; font-weight: bold; font-size: 13px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); display: none; z-index: 2000; border: 2px solid #e74c3c; text-align: center; }

        .arcade-container { background: #1e272e; padding: 8px; border-radius: 8px; margin: 8px auto; border: 2px solid #f39c12; width: 260px; height: 110px; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .arcade-canvas { background: #485460; border-radius: 6px; display: block; margin: 0 auto; cursor: pointer; }
        .arcade-hud { font-size: 13px; color: #f39c12; margin-bottom: 4px; font-weight: bold; display: flex; justify-content: space-between; width: 100%; }

        .controls-cielo { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 6px; }
        .controls-cielo button { padding: 12px; font-size: 16px; background: #e67e22; border-radius: 8px; }

        .chat-container { background: #2c3e50; padding: 10px; border-radius: 8px; border: 2px solid #16a085; margin-bottom: 10px; text-align: left; font-size: 13px; }
        .chat-messages { height: 130px; overflow-y: auto; background: #34495e; padding: 6px; border-radius: 6px; margin-bottom: 6px; display: flex; flex-direction: column; gap: 4px; }
        .chat-messages p { margin: 0; font-size: 12px; word-break: break-word; }
        .chat-container input { width: 100%; padding: 8px; border-radius: 6px; border: none; font-size: 13px; margin: 4px 0; box-sizing: border-box; }

        .score-container-2048 { font-size: 14px; color: #f39c12; font-weight: bold; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; padding: 0 10px; }
        .grid-2048 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; background: #bbada0; padding: 5px; border-radius: 6px; width: 220px; height: 220px; margin: 0 auto; box-sizing: border-box; }
        .cell-2048 { background: #cdc1b4; border-radius: 4px; display: flex; justify-content: center; align-items: center; font-weight: bold; font-size: 18px; }
        .controls-2048 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; width: 150px; margin: 8px auto; }
        .controls-2048 button { padding: 8px; font-size: 14px; background: #8f7a66; }
    </style>
</head>
<body>
    <div id="notificacionLogro">🏆 ¡Nuevo Logro Desbloqueado!</div>
    <div id="goldyReaccion">🐾 ¡Reacción graciosa!</div>
    <div id="avisoDinero">🪙 ¡Aún no tienes suficiente dinero! Juega minijuegos para desbloquearla</div>

    <div class="header-stats">
        <div style="margin-bottom: 8px; display: flex; justify-content: center; align-items: center; gap: 10px;">
            <button id="toqueBtn" onclick="darToque()" style="margin: 0;">👉 Dar un toque</button>
            <div style="background: #2c3e50; padding: 6px 12px; border-radius: 20px; border: 2px solid #f39c12; font-weight: bold; color: #f1c40f; font-size: 14px; display: flex; align-items: center; gap: 6px;">
                <span>🪙</span> <span id="monedasDisplay">50</span>
            </div>
            <button id="retosBtnHeader" onclick="abrirRetosDiarios()" title="Retos Diarios">📆</button>
        </div>
        <div id="nombreDisplay" style="font-weight: bold; color: #f1c40f; margin-bottom: 4px;">Mascota: Goldy</div>
        <div id="nivelDisplay">Nivel: 1</div>
        <div class="stats">
            <span>😊 <span id="fun">100</span></span>
            <span>🍔 <span id="food">100</span></span>
            <span>🔋 <span id="energy">100</span></span>
            <span>➕ <span id="health">100</span></span>
            <span id="cleanStat">🛁 <span id="clean">100</span></span>
        </div>
    </div>
    <canvas id="gameCanvas" width="300" height="250"></canvas>
    <div class="controls">
        <button id="infoBtn" onclick="abrirInfo()">📋 Estado e Información</button>
        <button id="chatBtn" onclick="abrirChat()">💬 Chat Multijugador</button>
        <button class="menu-btn" onclick="abrirVestidor()">👕 Vestidor</button>
        <button class="menu-btn" style="background: #2980b9;" onclick="abrirMinijuegos()">🎮 Seleccionar Minijuego</button>
        <button id="logrosBtn" onclick="abrirLogros()">🏆 Logros (<span id="logrosCompletados">0</span>/33)</button>
        <button onclick="acariciar()">🐾 Acariciar</button>
        <button onclick="alimentar()">🍔 Alimentar</button>
        <button onclick="dormir()">🔋 Dormir</button>
        <button onclick="vacunar()">➕ Vacunar</button>
        <button id="bathBtn" onclick="banar()">🛁 Bañar</button>
        <button id="maxBtn" onclick="maximizar()">🌟 Maximizar (🪙 2000)</button>
        <button id="fondosBtn" onclick="abrirFondos()">🌄 Fondos</button>
        <button id="resetBtn" onclick="resetearNivel()">🔄 Reiniciar Todo</button>
    </div>

    <!-- Modales -->
    <div id="chatModal" class="modal">
        <div class="modal-content">
            <h3>💬 Chat Multijugador</h3>
            <div style="margin-bottom: 8px;">
                <label style="font-size: 12px; color: #f1c40f;">Código de Sala:</label>
                <div style="display: flex; gap: 6px; margin-top: 4px;">
                    <input type="text" id="inputSala" placeholder="Ej. 100" style="padding: 6px; width: 70%; border-radius: 6px; border: none; font-size: 13px; text-align: center;">
                    <button onclick="conectarSala()" style="padding: 6px 10px; font-size: 12px; background: #27ae60; border-radius: 6px; border:none; color:white; cursor:pointer;">Conectar</button>
                </div>
            </div>
            <div class="chat-container">
                <div id="chatMessages" class="chat-messages">
                    <p style="color: #bdc3c7; text-align: center;">Conéctate a una sala para chatear.</p>
                </div>
                <input type="text" id="inputChat" placeholder="Escribe un mensaje..." onkeypress="if(event.key === 'Enter') enviarMensajeChat()">
                <button onclick="enviarMensajeChat()" style="width: 100%; padding: 8px; font-size: 13px; background: #27ae60; border-radius: 6px; border: none; color: white; cursor: pointer;">Enviar</button>
            </div>
            <button class="close-btn" onclick="cerrarChat()">Cerrar</button>
        </div>
    </div>

    <div id="infoModal" class="modal">
        <div class="modal-content">
            <h3>Información de la Mascota</h3>
            <div class="name-input-container">
                <input type="text" id="inputNombreMascota" placeholder="Nuevo nombre...">
                <button onclick="cambiarNombreMascota()" style="padding: 6px 10px; margin-top: 4px; font-size: 12px; background: #27ae60; border-radius: 6px; border:none; color:white; cursor:pointer;">Cambiar</button>
            </div>
            <div class="info-box">
                <p><strong>Nombre:</strong> <span id="infoNombre">Goldy</span></p>
                <p><strong>Nivel:</strong> <span id="infoNivel">1</span></p>
                <p><strong>Pelaje:</strong> <span id="infoPelaje">Pelaje de Goldy</span></p>
                <p><strong>Felicidad:</strong> <span id="infoFun">100</span>/100</p>
                <p><strong>Comida:</strong> <span id="infoFood">100</span>/100</p>
                <p><strong>Energía:</strong> <span id="infoEnergy">100</span>/100</p>
                <p><strong>Salud:</strong> <span id="infoHealth">100</span>/100</p>
                <p><strong>Limpieza:</strong> <span id="infoClean">100</span>/100</p>
            </div>
            <button class="close-btn" onclick="cerrarInfo()">Cerrar</button>
        </div>
    </div>

    <div id="logrosModal" class="modal">
        <div class="modal-content" style="max-width: 330px;">
            <h3>🏆 Logros y Trofeos</h3>
            <div id="listaLogros" style="max-height: 280px; overflow-y: auto; display: flex; flex-direction: column;"></div>
            <button class="close-btn" onclick="cerrarLogros()" style="margin-top: 10px;">Cerrar</button>
        </div>
    </div>

    <div id="retosModal" class="modal">
        <div class="modal-content" style="max-width: 330px;">
            <h3>📆 Retos Diarios</h3>
            <div id="listaRetos" style="max-height: 280px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;"></div>
            <button class="close-btn" onclick="cerrarRetosDiarios()" style="margin-top: 10px;">Cerrar</button>
        </div>
    </div>

    <div id="vestidorModal" class="modal">
        <div class="modal-content">
            <h3 id="tituloVestidor">Vestidor</h3>
            <div class="vestidor-tabs">
                <button class="tab-btn active" onclick="cambiarPestana('ropa')">Ropa (Máx. 2)</button>
                <button class="tab-btn" onclick="cambiarPestana('pelaje')">Pelaje (Máx. 1)</button>
            </div>
            <div id="seccionRopa" class="vestidor-section active"><div class="item-grid" id="gridRopa"></div></div>
            <div id="seccionPelaje" class="vestidor-section"><div class="item-grid" id="gridPelajes"></div></div>
            <button class="close-btn" onclick="cerrarVestidor()">Cerrar</button>
        </div>
    </div>

    <div id="fondosModal" class="modal">
        <div class="modal-content">
            <h3>Seleccionar Fondo</h3>
            <div class="item-grid" id="gridFondos"></div>
            <button class="close-btn" onclick="cerrarFondos()">Cerrar</button>
        </div>
    </div>

    <div id="minijuegosModal" class="modal">
        <div class="modal-content">
            <h3>Elige un Minijuego</h3>
            <div class="item-grid" id="listaMinijuegos"></div>
            <button class="close-btn" onclick="cerrarMinijuegos()">Salir del Menú</button>
        </div>
    </div>

    <div id="game2048Modal" class="modal">
        <div class="modal-content" style="position: relative;">
            <h3>Minijuego 2048</h3>
            <div class="score-container-2048"><span>Puntos: <span id="score2048">0</span></span></div>
            <div class="grid-2048" id="grid2048"></div>
            <div class="controls-2048">
                <div></div><button onclick="mover2048('arriba')">⬆️</button><div></div>
                <button onclick="mover2048('izquierda')">⬅️</button>
                <button onclick="mover2048('abajo')">⬇️</button>
                <button onclick="mover2048('derecha')">➡️</button>
            </div>
            <button class="close-btn" onclick="cerrar2048()">❌ Salir</button>
        </div>
    </div>

    <div id="atrapaRanaModal" class="modal">
        <div class="modal-content" style="max-width: 300px;">
            <h3>Atrapa la Rana 🐸</h3>
            <div class="arcade-hud"><span>Nivel: <span id="ranaNivel">1</span></span><span>Puntos: <span id="ranaPuntos">0</span></span></div>
            <div class="arcade-container"><canvas id="ranaCanvas" class="arcade-canvas" width="240" height="90"></canvas></div>
            <button id="btnAtraparRana" onclick="intentarAtraparRana()" style="background: #27ae60; width: 100%; margin-top: 4px; padding: 10px; font-weight: bold; border-radius: 8px; border:none; color:white; cursor:pointer;">🎯 ¡ATRAPAR!</button>
            <button class="close-btn" onclick="cerrarAtrapaRana()">❌ Salir</button>
        </div>
    </div>

    <div id="saltoPicosModal" class="modal">
        <div class="modal-content" style="max-width: 300px;" onclick="saltarPicosInput()">
            <h3>Salto Fugaz ⬛</h3>
            <div class="arcade-hud"><span>Puntos: <span id="picosScore">0</span></span><span style="font-size: 10px; color: #bdc3c7;">(Toca para saltar)</span></div>
            <div class="arcade-container"><canvas id="picosCanvas" class="arcade-canvas" width="240" height="90"></canvas></div>
            <button class="close-btn" onclick="event.stopPropagation(); cerrarSaltoPicos()">❌ Salir</button>
        </div>
    </div>

    <div id="saltoCieloModal" class="modal">
        <div class="modal-content" style="max-width: 300px;">
            <h3>Salto al Cielo ☁️</h3>
            <div class="arcade-hud"><span>Altura: <span id="cieloAltura">0</span>m</span><span style="font-size: 11px; color: #f1c40f;" id="cieloCapa">Capa: Cueva</span></div>
            <div class="arcade-container" style="width: 240px; height: 160px;"><canvas id="cieloCanvas" class="arcade-canvas" width="240" height="150"></canvas></div>
            <div class="controls-cielo">
                <button ontouchstart="moverCielo('izq')" onmousedown="moverCielo('izq')">⬅️ Izq</button>
                <button ontouchstart="moverCielo('der')" onmousedown="moverCielo('der')">Der ➡️</button>
            </div>
            <button class="close-btn" onclick="cerrarSaltoCielo()" style="margin-top: 6px;">❌ Salir</button>
        </div>
    </div>
   <script>
        // Configuración de Firebase (Base de datos en tiempo real pública de prueba)
        const firebaseConfig = {
            databaseURL: "https://mygoldy-multiplayer-default-rtdb.firebaseio.com/"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        let salaActual = null;
        let miIdJugador = 'jugador_' + Math.random().toString(36).substr(2, 9);
        let amigoDatos = null;

        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");
        
        let stats = JSON.parse(localStorage.getItem("goldy_stats")) || { fun: 100, food: 100, energy: 100, health: 100, clean: 100 };
        if(stats.clean === undefined) stats.clean = 100;
        
        let monedasGuardadas = localStorage.getItem("goldy_monedas");
        let monedas = (monedasGuardadas !== null && !isNaN(parseInt(monedasGuardadas, 10))) ? parseInt(monedasGuardadas, 10) : 50;

        let nivel = parseInt(localStorage.getItem("goldy_nivel")) || 1;
        let contadorStatsRellenadas = parseInt(localStorage.getItem("goldy_stats_rellenadas")) || 0;
        let contadorMinijuegosJugados = parseInt(localStorage.getItem("goldy_minijuegos_jugados")) || 0;
        let nombreMascota = localStorage.getItem("goldy_nombre") || "Goldy";
        
        let ropaEquipada = JSON.parse(localStorage.getItem("goldy_ropa_equipada")) || [];
        if (ropaEquipada.length === 0 && localStorage.getItem("goldy_ropa") && localStorage.getItem("goldy_ropa") !== "ninguna") {
            ropaEquipada = [localStorage.getItem("goldy_ropa")];
        }

        let pelajeActual = localStorage.getItem("goldy_pelaje") || "normal";
        let nombrePelajeActual = localStorage.getItem("goldy_nombre_pelaje") || "Pelaje de Goldy";
        let fondoActual = localStorage.getItem("goldy_fondo") || "verde";

        let ropaDesbloqueada = JSON.parse(localStorage.getItem("goldy_ropa_desbloqueada")) || { "ninguna": true, "collar": false, "gorro1": false, "gorro2": false, "gafas_sol": false };
        let pelajesDesbloqueados = JSON.parse(localStorage.getItem("goldy_pelajes_desbloqueados")) || { "normal": true, "marron": false, "blanco": false, "marron_blanco": false, "negro_blanco": false };
        let fondosDesbloqueados = JSON.parse(localStorage.getItem("goldy_fondos_desbloqueados")) || { "verde": true, "sala": false, "cielo": false, "espacio": false };

        let fechaHoyStr = new Date().toDateString();
        let datosRetosGuardados = JSON.parse(localStorage.getItem("goldy_retos_diarios")) || {};

        function generarRetosDelDia() {
            const bancoRetos = [
                { desc: () => `Alimenta a ${nombreMascota} 2 veces`, tipo: 'alimentar', meta: 2 },
                { desc: () => `Juega cualquier minijuego 2 veces`, tipo: 'minijuego', meta: 2 },
                { desc: () => `Baña a ${nombreMascota} 1 vez`, tipo: 'banar', meta: 1 },
                { desc: () => `Acaricia a ${nombreMascota} 3 veces`, tipo: 'acariciar', meta: 3 }
            ];
            return bancoRetos.map((r, idx) => ({ id: `reto_${idx + 1}`, desc: r.desc(), tipo: r.tipo, meta: r.meta, progreso: 0, completado: false, reclamado: false }));
        }

        if (!datosRetosGuardados.fecha || datosRetosGuardados.fecha !== fechaHoyStr) {
            datosRetosGuardados = { fecha: fechaHoyStr, retos: generarRetosDelDia() };
            localStorage.setItem("goldy_retos_diarios", JSON.stringify(datosRetosGuardados));
        }

        function verificarProgresoRetos(tipoAccion) {
            fechaHoyStr = new Date().toDateString();
            if (!datosRetosGuardados.fecha || datosRetosGuardados.fecha !== fechaHoyStr) {
                datosRetosGuardados = { fecha: fechaHoyStr, retos: generarRetosDelDia() };
            }
            let actualizados = false;
            datosRetosGuardados.retos.forEach(reto => {
                if (!reto.completado && reto.tipo === tipoAccion) {
                    reto.progreso++;
                    if (reto.progreso >= reto.meta) reto.completado = true;
                    actualizados = true;
                }
            });
            if (actualizados) localStorage.setItem("goldy_retos_diarios", JSON.stringify(datosRetosGuardados));
        }

        function reclamarReto(idReto) {
            let reto = datosRetosGuardados.retos.find(r => r.id === idReto);
            if (reto && reto.completado && !reto.reclamado) {
                reto.reclamado = true;
                monedas += 100;
                localStorage.setItem("goldy_retos_diarios", JSON.stringify(datosRetosGuardados));
                updateUI();
                abrirRetosDiarios();
                mostrarReaccionGoldy("🪙 ¡+100 monedas!");
            }
        }

        function abrirRetosDiarios() {
            const contenedor = document.getElementById("listaRetos");
            contenedor.innerHTML = "";
            datosRetosGuardados.retos.forEach(reto => {
                let card = document.createElement("div");
                card.className = `logro-card ${reto.reclamado ? 'desbloqueado' : ''}`;
                let botonAccion = reto.reclamado ? '✅ Reclamado' : (reto.completado ? `<button onclick="reclamarReto('${reto.id}')" style="background:#27ae60;padding:4px 8px;color:white;border:none;border-radius:4px;">Reclamar</button>` : `Progreso: ${reto.progreso}/${reto.meta}`);
                card.innerHTML = `<div class="logro-icono">📅</div><div class="logro-info" style="flex-grow:1;"><h4 style="margin:0;">${reto.desc}</h4><p>${botonAccion}</p></div>`;
                contenedor.appendChild(card);
            });
            document.getElementById("retosModal").style.display = "flex";
        }
        function cerrarRetosDiarios() { document.getElementById("retosModal").style.display = "none"; }

        // --- SISTEMA MULTIJUGADOR Y CHAT ---
        function abrirChat() { document.getElementById("chatModal").style.display = "flex"; }
        function cerrarChat() { document.getElementById("chatModal").style.display = "none"; }

        function conectarSala() {
            const codigo = document.getElementById("inputSala").value.trim();
            if(!codigo) { alert("Introduce un código de sala válido (ej. 100)"); return; }
            
            if(salaActual) {
                // Desconectar del anterior
                db.ref("salas/" + salaActual + "/jugadores/" + miIdJugador).remove();
            }

            salaActual = codigo;
            alert("¡Conectado a la sala " + salaActual + "!");
            
            // Escuchar jugadores en la sala
            db.ref("salas/" + salaActual + "/jugadores").on("value", (snapshot) => {
                let val = snapshot.val();
                amigoDatos = null;
                if(val) {
                    for(let id in val) {
                        if(id !== miIdJugador) {
                            amigoDatos = val[id];
                        }
                    }
                }
            });

            // Escuchar mensajes del chat
            db.ref("salas/" + salaActual + "/mensajes").on("child_added", (snapshot) => {
                let msg = snapshot.val();
                let chatBox = document.getElementById("chatMessages");
                chatBox.innerHTML += `<p><strong>${msg.remitente}:</strong> ${msg.texto}</p>`;
                chatBox.scrollTop = chatBox.scrollHeight;
            });

            sincronizarMisDatosEnNube();
        }

        function sincronizarMisDatosEnNube() {
            if(!salaActual) return;
            db.ref("salas/" + salaActual + "/jugadores/" + miIdJugador).set({
                nombre: nombreMascota,
                pelaje: pelajeActual,
                ropa: ropaEquipada
            });
        }

        function enviarMensajeChat() {
            const input = document.getElementById("inputChat");
            const texto = input.value.trim();
            if(!texto || !salaActual) return;

            db.ref("salas/" + salaActual + "/mensajes").push({
                remitente: nombreMascota,
                texto: texto
            });
            input.value = "";
        }
        // ------------------------------------

        let statsContadores = JSON.parse(localStorage.getItem("goldy_stats_contadores")) || { banos: 0, comidas: 0, energias: 0, vacunas: 0, minijuegos: 0, acaricias: 0, maxScore2048: 0, maxPuntosRana: 0, maxPuntosPicos: 0, maxAlturaCielo: 0 };
        let logrosDesbloqueados = JSON.parse(localStorage.getItem("goldy_logros")) || {};
        
        function getDefinicionesLogros() {
            return [
                { id: 'bano_1', titulo: 'Primera Burbuja', desc: `Baña a ${nombreMascota} 1 vez.`, icono: '🛁' },
                { id: 'comida_1', titulo: 'Primer Bocado', desc: `Alimenta a ${nombreMascota} 1 vez.`, icono: '🍔' },
                { id: 'energia_1', titulo: 'Primeros Sueños', desc: `Duerme a ${nombreMascota} 1 vez.`, icono: '🔋' },
                { id: 'salud_1', titulo: 'Sano y Salvo', desc: `Cura a ${nombreMascota} 1 vez.`, icono: '➕' },
                { id: 'mini_1', titulo: 'Primer Juego', desc: 'Juega un minijuego 1 vez.', icono: '🎮' },
                { id: 'caricia_1', titulo: 'Primeros Apaños', desc: `Acaricia a ${nombreMascota} 1 vez.`, icono: '🐾' },
                { id: 'platino', titulo: 'Leyenda Absoluta', desc: 'Desbloquea todos los demás logros.', icono: '🌟' }
            ];
        }
        
        let durmiendo = false, acariciando = false, banando = false;
        const minijuegos = ["2048 🎮", "Atrapa la Rana 🐸", "Salto Fugaz ⬛", "Salto al Cielo ☁️"];

        function inicializarModalMinijuegos() {
            const contenedor = document.getElementById("listaMinijuegos");
            contenedor.innerHTML = "";
            minijuegos.forEach(juego => {
                let btn = document.createElement("button");
                btn.className = "item-btn";
                btn.style.background = "#e67e22";
                btn.innerText = juego;
                btn.onclick = () => ejecutarMinijuegoSeleccionado(juego);
                contenedor.appendChild(btn);
            });
        }
        inicializarModalMinijuegos();

        function renderizarOpcionesRopa() {
            const grid = document.getElementById("gridRopa");
            grid.innerHTML = "";
            const itemsRopa = [
                { id: 'ninguna', nombre: 'Ninguna', costo: 0 },
                { id: 'collar', nombre: 'Collar Rojo', costo: 150 },
                { id: 'gorro1', nombre: 'Gorro Clásico', costo: 300 },
                { id: 'gafas_sol', nombre: 'Gafas de sol 😎', costo: 750 }
            ];
            itemsRopa.forEach(item => {
                let comprado = ropaDesbloqueada[item.id];
                let equipado = ropaEquipada.includes(item.id);
                let btn = document.createElement("button");
                btn.className = "item-btn";
                btn.innerHTML = `<span>${item.nombre}</span> <span style="font-size: 11px; color: #f1c40f;">${comprado ? (equipado ? '✅ Equipado' : '👕 Usar') : '🪙 ' + item.costo}</span>`;
                btn.onclick = () => {
                    if (comprado) { cambiarVestimenta(item.id); } 
                    else if (monedas >= item.costo) { monedas -= item.costo; ropaDesbloqueada[item.id] = true; cambiarVestimenta(item.id); }
                };
                grid.appendChild(btn);
            });
        }

        function renderizarOpcionesPelaje() {
            const grid = document.getElementById("gridPelajes");
            grid.innerHTML = "";
            const itemsPelaje = [
                { id: 'normal', nombre: 'Pelaje de Goldy', costo: 0 },
                { id: 'marron', nombre: 'Pelaje Marrón', costo: 250 },
                { id: 'blanco', nombre: 'Pelaje Blanco', costo: 250 }
            ];
            itemsPelaje.forEach(item => {
                let comprado = pelajesDesbloqueados[item.id];
                let equipado = pelajeActual === item.id;
                let btn = document.createElement("button");
                btn.className = "item-btn";
                btn.innerHTML = `<span>${item.nombre}</span> <span style="font-size: 11px; color: #f1c40f;">${comprado ? (equipado ? '✅ Equipado' : '🐾 Usar') : '🪙 ' + item.costo}</span>`;
                btn.onclick = () => {
                    if (comprado) { cambiarPelaje(item.id, item.nombre); } 
                    else if (monedas >= item.costo) { monedas -= item.costo; pelajesDesbloqueados[item.id] = true; cambiarPelaje(item.id, item.nombre); }
                };
                grid.appendChild(btn);
            });
        }

        function renderizarOpcionesFondos() {
            const grid = document.getElementById("gridFondos");
            grid.innerHTML = "";
            const itemsFondos = [
                { id: 'verde', nombre: 'Fondo Verde', costo: 0 },
                { id: 'sala', nombre: 'Sala de Estar', costo: 350 },
                { id: 'espacio', nombre: 'Espacio', costo: 1200 }
            ];
            itemsFondos.forEach(item => {
                let comprado = fondosDesbloqueados[item.id];
                let equipado = fondoActual === item.id;
                let btn = document.createElement("button");
                btn.className = "item-btn";
                btn.innerHTML = `<span>${item.nombre}</span> <span style="font-size: 11px; color: #f1c40f;">${comprado ? (equipado ? '✅ Equipado' : '🌄 Usar') : '🪙 ' + item.costo}</span>`;
                btn.onclick = () => {
                    if (comprado) { cambiarFondo(item.id); } 
                    else if (monedas >= item.costo) { monedas -= item.costo; fondosDesbloqueados[item.id] = true; cambiarFondo(item.id); }
                };
                grid.appendChild(btn);
            });
        }

        function saveGame() {
            localStorage.setItem("goldy_stats", JSON.stringify(stats));
            localStorage.setItem("goldy_monedas", monedas);
            localStorage.setItem("goldy_nivel", nivel);
            localStorage.setItem("goldy_nombre", nombreMascota);
            localStorage.setItem("goldy_ropa_equipada", JSON.stringify(ropaEquipada));
            localStorage.setItem("goldy_pelaje", pelajeActual);
            localStorage.setItem("goldy_fondo", fondoActual);
            sincronizarMisDatosEnNube();
        }

        function updateUI() {
            for(let s in stats) stats[s] = Math.max(0, Math.min(100, stats[s]));
            document.getElementById("fun").innerText = Math.floor(stats.fun);
            document.getElementById("food").innerText = Math.floor(stats.food);
            document.getElementById("energy").innerText = Math.floor(stats.energy);
            document.getElementById("health").innerText = Math.floor(stats.health);
            document.getElementById("clean").innerText = Math.floor(stats.clean);

            document.getElementById("monedasDisplay").innerText = monedas;
            document.getElementById("nombreDisplay").innerText = "Mascota: " + nombreMascota;
            document.getElementById("nivelDisplay").innerText = "Nivel: " + nivel;
            document.getElementById("infoNombre").innerText = nombreMascota;
            document.getElementById("infoNivel").innerText = nivel;
            renderizarOpcionesRopa();
            renderizarOpcionesPelaje();
            renderizarOpcionesFondos();
            saveGame();
        }

        function cambiarNombreMascota() {
            const input = document.getElementById("inputNombreMascota");
            let nuevoNombre = input.value.trim();
            if(nuevoNombre !== "") {
                nombreMascota = nuevoNombre;
                input.value = "";
                updateUI();
                alert("¡Nombre actualizado a " + nombreMascota + "!");
            }
        }

        function abrirInfo() { document.getElementById("infoModal").style.display = "flex"; updateUI(); }
        function cerrarInfo() { document.getElementById("infoModal").style.display = "none"; }
        function abrirVestidor() { document.getElementById("vestidorModal").style.display = "flex"; }
        function cerrarVestidor() { document.getElementById("vestidorModal").style.display = "none"; }
        function abrirFondos() { document.getElementById("fondosModal").style.display = "flex"; }
        function cerrarFondos() { document.getElementById("fondosModal").style.display = "none"; }
        function abrirMinijuegos() { if(!durmiendo && !banando) document.getElementById("minijuegosModal").style.display = "flex"; }
        function cerrarMinijuegos() { document.getElementById("minijuegosModal").style.display = "none"; }

        function cambiarVestimenta(tipo) {
            if (tipo === 'ninguna') ropaEquipada = [];
            else {
                if(ropaEquipada.includes(tipo)) ropaEquipada = ropaEquipada.filter(r => r !== tipo);
                else if(ropaEquipada.length < 2) ropaEquipada.push(tipo);
            }
            updateUI();
        }

        function cambiarPelaje(tipo, nombrePelaje) { pelajeActual = tipo; updateUI(); }
        function cambiarFondo(tipoFondo) { fondoActual = tipoFondo; updateUI(); }

        function ejecutarMinijuegoSeleccionado(juegoElegido) {
            cerrarMinijuegos();
            verificarProgresoRetos('minijuego');
            if (juegoElegido === "2048 🎮") { iniciar2048(); }
            else if (juegoElegido === "Atrapa la Rana 🐸") { iniciarAtrapaRana(); }
            else if (juegoElegido === "Salto Fugaz ⬛") { iniciarSaltoPicos(); }
            else if (juegoElegido === "Salto al Cielo ☁️") { iniciarSaltoCielo(); }
        }

        function alimentar() { stats.food += 20; verificarProgresoRetos('alimentar'); updateUI(); }
        function vacunar() { stats.health = 100; updateUI(); }
        function banar() { 
            if(durmiendo || banando) return;
            banando = true;
            setTimeout(() => { stats.clean = 100; banando = false; verificarProgresoRetos('banar'); updateUI(); }, 1200);
        }
        function acariciar() { stats.fun += 15; verificarProgresoRetos('acariciar'); updateUI(); }
        function dormir() { 
            if(durmiendo || banando) return;
            durmiendo = true;
            let s = setInterval(() => {
                stats.energy += 10;
                if(stats.energy >= 100) { durmiendo = false; clearInterval(s); }
                updateUI();
            }, 500);
        }
        function maximizar() { 
            if (monedas >= 2000) { monedas -= 2000; stats = { fun: 100, food: 100, energy: 100, health: 100, clean: 100 }; updateUI(); }
            else { document.getElementById("avisoDinero").style.display = "block"; setTimeout(() => document.getElementById("avisoDinero").style.display = "none", 3000); }
        }
        function resetearNivel() { if(confirm("¿Reiniciar todo?")) { localStorage.clear(); location.reload(); } }

        // Función para pintar a Goldy (Sirve tanto para el tuyo como para el de tu amigo)
        function dibujarGoldy(posX, posY, pPelaje, pRopa, pNombre, escala = 1) {
            ctx.save();
            ctx.translate(posX, posY);
            ctx.scale(escala, escala);

            let colorOrejas = "#fb8c00", colorCabeza = "#ffeb3b", colorHocico = "#fff9c4";
            if (pPelaje === 'marron') { colorOrejas = "#5d4037"; colorCabeza = "#8d6e63"; colorHocico = "#d7ccc8"; }
            else if (pPelaje === 'blanco') { colorOrejas = "#e0e0e0"; colorCabeza = "#ffffff"; colorHocico = "#f5f5f5"; }

            // Orejas
            ctx.fillStyle = colorOrejas;
            ctx.beginPath(); ctx.ellipse(-60, 0, 25, 45, 0.4, 0, 7); ctx.fill();
            ctx.beginPath(); ctx.ellipse(60, 0, 25, 45, -0.4, 0, 7); ctx.fill();
            
            // Cabeza
            ctx.fillStyle = colorCabeza;
            ctx.beginPath(); ctx.arc(0, 0, 60, 0, 7); ctx.fill();
            
            // Hocico
            ctx.fillStyle = colorHocico;
            ctx.beginPath(); ctx.ellipse(0, 15, 35, 25, 0, 0, 7); ctx.fill();
            
            // Ojos
            ctx.fillStyle = "#333";
            ctx.beginPath(); ctx.arc(-20, -15, 6, 0, 7); ctx.fill();
            ctx.beginPath(); ctx.arc(20, -15, 6, 0, 7); ctx.fill();
            
            // Nariz
            ctx.beginPath(); ctx.ellipse(0, 8, 8, 5, 0, 0, 7); ctx.fill();

            // Ropa
            if(pRopa) {
                pRopa.forEach(r => {
                    if(r === 'collar') {
                        ctx.fillStyle = "#e74c3c";
                        ctx.beginPath(); ctx.ellipse(0, 35, 25, 8, 0, 0, 7); ctx.fill();
                        ctx.fillStyle = "#f1c40f";
                        ctx.beginPath(); ctx.arc(0, 41, 5, 0, 7); ctx.fill();
                    } else if(r === 'gorro1') {
                        ctx.fillStyle = "#2980b9";
                        ctx.beginPath(); ctx.arc(0, -45, 45, Math.PI, 2 * Math.PI); ctx.fill();
                    }
                });
            }

            // Nombre encima de la mascota
            ctx.fillStyle = "#f1c40f";
            ctx.font = "bold 14px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(pNombre, 0, -75);

            ctx.restore();
        }

        function draw() {
            ctx.clearRect(0, 0, 300, 250);

            // Fondo
            if (fondoActual === 'sala') canvas.style.background = "#d7ccc8";
            else if (fondoActual === 'espacio') canvas.style.background = "#111122";
            else canvas.style.background = "#9ccc65";

            // Dibuja tu propio Goldy en el centro
            dibujarGoldy(150, 130, pelajeActual, ropaEquipada, nombreMascota, 1);

            // Dibuja al Goldy de tu amigo a la izquierda si está conectado en la sala
            if (amigoDatos) {
                dibujarGoldy(70, 140, amigoDatos.pelaje, amigoDatos.ropa, amigoDatos.nombre, 0.75);
            }

            requestAnimationFrame(draw);
        }

        updateUI();
        requestAnimationFrame(loop);
        function loop() { draw(); }
    </script>
</body>
</html> 
